# Supabase public client config.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy fallback. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push public client key. Safe to expose to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Web Push server-only delivery config. Never prefix these with NEXT_PUBLIC_.
VAPID_PRIVATE_KEY=
# Must start with mailto: or https://, for example mailto:admin@example.com.
VAPID_SUBJECT=

# Server-only secret for push delivery fan-out and invalid subscription cleanup only.
# Never expose this to the browser or use it for normal app mutations.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Playwright inputs for real auth E2E tests.
# Leave empty to skip those tests.
E2E_AUTH_EMAIL=
E2E_AUTH_PASSWORD=
E2E_OTHER_AUTH_EMAIL=
E2E_OTHER_AUTH_PASSWORD=
E2E_AUTH_REGISTER_EMAIL_DOMAIN=
E2E_AUTH_REGISTER_PASSWORD=
E2E_AUTH_RESET_EMAIL=

# Optional performance diagnostics.
# PLAYWRIGHT_BASE_URL can point to a local app or deployed Vercel URL.
PLAYWRIGHT_BASE_URL=

# Server-side Supabase timing logs. Do not prefix with NEXT_PUBLIC_.
PERF_DEBUG=false
