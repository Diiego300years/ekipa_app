# Supabase public client config.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy fallback. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Never prefix this with NEXT_PUBLIC_.
# Not used in the current Supabase auth foundation phase.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Playwright inputs for real auth E2E tests.
# Leave empty to skip those tests.
E2E_AUTH_EMAIL=
E2E_AUTH_PASSWORD=
E2E_OTHER_AUTH_EMAIL=
E2E_OTHER_AUTH_PASSWORD=
E2E_AUTH_REGISTER_EMAIL_DOMAIN=
E2E_AUTH_REGISTER_PASSWORD=
E2E_AUTH_RESET_EMAIL=

# Optional performance diagnostics.
# PLAYWRIGHT_BASE_URL can point to a local app or deployed Vercel URL.
PLAYWRIGHT_BASE_URL=

# Server-side Supabase timing logs. Do not prefix with NEXT_PUBLIC_.
PERF_DEBUG=false
